<?xml version="1.0"?>
<robot name="environment_obstacles">
  <!--
    Environment Obstacles for Collision Detection
    All obstacles are static (welded to world)
    Coordinates match scene_obstacle_test.xml
  -->

  <!-- ========================================== -->
  <!-- TABLE (from scene_obstacle_test.xml)        -->
  <!-- ========================================== -->

  <!-- Table Top -->
  <link name="table_top">
    <inertial>
      <mass value="100.0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.35 0.25 0.05"/>
      </geometry>
      <origin xyz="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.35 0.25 0.05"/>
      </geometry>
      <origin xyz="0 0 0"/>
      <drake:proximity_properties>
        <drake:composite hydroelastic="true">
          <drake:hydroelastic>
            <drake:compliance_type type="soft"/>
            <drake:elastic_modulus value="1.0e7"/>
            <drake:resolution_hint value="1.0"/>
          </drake:hydroelastic>
        </drake:composite>
      </drake:proximity_properties>
    </collision>
  </link>

  <!-- Table Leg 1 -->
  <link name="table_leg1">
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.03 0.03 0.3"/>
      </geometry>
      <origin xyz="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.03 0.3"/>
      </geometry>
      <origin xyz="0 0 0"/>
    </collision>
  </link>

  <!-- Table Leg 2 -->
  <link name="table_leg2">
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.03 0.03 0.3"/>
      </geometry>
      <origin xyz="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.03 0.3"/>
      </geometry>
      <origin xyz="0 0 0"/>
    </collision>
  </link>

  <!-- Table Leg 3 -->
  <link name="table_leg3">
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.03 0.03 0.3"/>
      </geometry>
      <origin xyz="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.03 0.3"/>
      </geometry>
      <origin xyz="0 0 0"/>
    </collision>
  </link>

  <!-- Table Leg 4 -->
  <link name="table_leg4">
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.03 0.03 0.3"/>
      </geometry>
      <origin xyz="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.03 0.3"/>
      </geometry>
      <origin xyz="0 0 0"/>
    </collision>
  </link>

  <!-- Target Block -->
  <link name="obstacle_block">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.025" length="0.25"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.025" length="0.25"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- Obstacle Barrier -->
  <link name="obstacle_barrier">
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.15 0.05 0.08"/>
      </geometry>
      <origin xyz="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.15 0.05 0.08"/>
      </geometry>
      <origin xyz="0 0 0"/>
    </collision>
  </link>

  <!-- Obstacle Sphere -->
  <link name="obstacle_sphere">
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
      <origin xyz="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
      <origin xyz="0 0 0"/>
    </collision>
  </link>

  <!-- Obstacle Cylinder -->
  <link name="obstacle_cylinder">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.12"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.12"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- ========================================== -->
  <!-- JOINTS: Weld all obstacles to world         -->
  <!-- ========================================== -->

  <!-- Weld table top to world at (0.5, 0, 0.62) -->
  <joint name="table_top_joint" type="fixed">
    <parent link="world"/>
    <child link="table_top"/>
    <origin xyz="0.5 0.0 0.62" rpy="0 0 0"/>
  </joint>

  <!-- Weld table leg 1 to world at (0.18, 0.22, 0.3) -->
  <joint name="table_leg1_joint" type="fixed">
    <parent link="world"/>
    <child link="table_leg1"/>
    <origin xyz="0.18 0.22 0.3" rpy="0 0 0"/>
  </joint>

  <!-- Weld table leg 2 to world at (0.18, -0.22, 0.3) -->
  <joint name="table_leg2_joint" type="fixed">
    <parent link="world"/>
    <child link="table_leg2"/>
    <origin xyz="0.18 -0.22 0.3" rpy="0 0 0"/>
  </joint>

  <!-- Weld table leg 3 to world at (0.82, 0.22, 0.3) -->
  <joint name="table_leg3_joint" type="fixed">
    <parent link="world"/>
    <child link="table_leg3"/>
    <origin xyz="0.82 0.22 0.3" rpy="0 0 0"/>
  </joint>

  <!-- Weld table leg 4 to world at (0.82, -0.22, 0.3) -->
  <joint name="table_leg4_joint" type="fixed">
    <parent link="world"/>
    <child link="table_leg4"/>
    <origin xyz="0.82 -0.22 0.3" rpy="0 0 0"/>
  </joint>

  <!-- Weld target block to world at (0.65, 0.0, 0.82) -->
  <joint name="obstacle_block_joint" type="fixed">
    <parent link="world"/>
    <child link="obstacle_block"/>
    <origin xyz="0.65 0.0 0.82" rpy="0 0 0"/>
  </joint>

  <!-- Weld barrier to world at (0.6, 0.0, 0.65) -->
  <joint name="obstacle_barrier_joint" type="fixed">
    <parent link="world"/>
    <child link="obstacle_barrier"/>
    <origin xyz="0.6 0.0 0.65" rpy="0 0 0"/>
  </joint>

  <!-- Weld sphere to world at (0.55, 0.15, 0.7) -->
  <joint name="obstacle_sphere_joint" type="fixed">
    <parent link="world"/>
    <child link="obstacle_sphere"/>
    <origin xyz="0.55 0.15 0.7" rpy="0 0 0"/>
  </joint>

  <!-- Weld cylinder to world at (0.7, -0.12, 0.75) -->
  <joint name="obstacle_cylinder_joint" type="fixed">
    <parent link="world"/>
    <child link="obstacle_cylinder"/>
    <origin xyz="0.7 -0.12 0.75" rpy="0 0 0"/>
  </joint>

</robot>
